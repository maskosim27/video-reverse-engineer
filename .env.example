APP_PORT=3000
BACKEND_PORT=8000

DATABASE_URL=sqlite:///./data/app.db
VIDEO_STORAGE_PATH=./data/videos
FRAME_STORAGE_PATH=./data/frames

# Kunci untuk mengenkripsi API key yang disimpan via UI. Wajib diisi untuk deployment.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NineRouter = gateway lokal OpenAI-compatible (default http://127.0.0.1:20128/v1)
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1

AI_MODEL=google/gemini-2.5-flash
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=8000

# Whisper lokal (faster-whisper). Model diunduh otomatis saat pertama dipakai.
# tiny|base|small|medium — base ~145MB, cukup untuk ID/EN santai.
WHISPER_MODEL=base
# Bahasa OCR Tesseract
OCR_LANG=eng+ind

# Checkpoint berikutnya (belum dipakai)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
